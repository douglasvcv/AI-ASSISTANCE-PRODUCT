{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2020",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "types": ["node"],

    "sourceMap": true,

    "skipLibCheck": true,

    "isolatedModules": true,

    "verbatimModuleSyntax": true
  },

  "include": ["src"]
}